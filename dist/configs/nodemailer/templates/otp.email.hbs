<!DOCTYPE html>
<html>
<head>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
    }
    .email-container {
      max-width: 600px;
      margin: auto;
      background: #ffffff;
      border-radius: 8px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
    }
    .header {
      background: #ff9800;
      color: white;
      text-align: center;
      padding: 20px;
      font-size: 24px;
    }
    .body {
      padding: 20px;
      color: #333;
    }
    .footer {
      text-align: center;
      background: #eee;
      padding: 10px;
      font-size: 12px;
    }
  </style>
</head>
<body>
  <div class="email-container">
    <div class="header">{{purposeTitle}}</div>

    <div class="body">
      <p>Hi {{fullname}},</p>

      <p>
        You are receiving this email for
        <b>{{purposeDescription}}</b>.
      </p>

      <p>Your verification code is:</p>
      <h2>{{otp}}</h2>

      <p>This code will expire in 5 minutes.</p>
{{!-- 
      {{#if extraNote}}
        <p><i>{{extraNote}}</i></p>
      {{/if}} --}}
    </div>

    <div class="footer">
      © 2026 Therfti App. All Rights Reserved.
    </div>
  </div>
</body>
</html>
